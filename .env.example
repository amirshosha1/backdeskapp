# Phase P
# WhatsApp number or form URL the pricing page's pre-order button opens.
# Until this is set, the button shows a clearly marked placeholder
# (BUILD_PLAN.md §6, question 2).
NEXT_PUBLIC_PREORDER_URL=

# WhatsApp number the "رأيك؟" feedback button opens (wa.me/<number>, digits
# only, country code included, no leading +). Until this is set, the
# feedback button is hidden.
NEXT_PUBLIC_FEEDBACK_WHATSAPP=

