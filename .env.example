# Backdesk — environment variables (names only; never commit real values).
# CLAUDE.md §5: Claude only ever sees dev keys. Prod keys live in Vercel and
# GitHub secrets only.

# Phase P
# WhatsApp number or form URL the pricing page's pre-order button opens.
# Until this is set, the button shows a clearly marked placeholder
# (BUILD_PLAN.md §6, question 2).
NEXT_PUBLIC_PREORDER_URL=

# WhatsApp number the "رأيك؟" feedback button opens (wa.me/<number>, digits
# only, country code included, no leading +). Until this is set, the
# feedback button is hidden.
NEXT_PUBLIC_FEEDBACK_WHATSAPP=

# Phase 0b (Batch 3): Google sign-in through Supabase Auth. Used from PR B.
# Both values reach the browser by design; neither is a secret. Values and
# where to find them: docs/SETUP_AUTH.md step 5. No service-role or secret
# key is used anywhere in this batch.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Later in Phase 0b and beyond (not used yet)
# RESEND_API_KEY=
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=

# `pnpm test:db` needs no variables: scripts/test-db.sh starts its own
# throwaway Postgres. Optional: PG_BINDIR (Postgres server binaries),
# TEST_PG_PORT (default 54329).

# Phase 4
# PAYMOB_API_KEY=
# PAYMOB_HMAC_SECRET=

# Phase 8
# ANTHROPIC_API_KEY=
# AI_MODEL_FAST=claude-haiku-4-5-20251001
# AI_MODEL_VISION=claude-sonnet-5
