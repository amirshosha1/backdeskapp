# Backdesk — environment variables (names only; never commit real values).
# CLAUDE.md §5: Claude never sees Supabase keys or secrets; the values live
# in Vercel and the Supabase dashboard only.

# Phase P
# WhatsApp number or form URL the pricing page's pre-order button opens.
# Until this is set, the button shows a clearly marked placeholder
# (BUILD_PLAN.md §6, question 2).
NEXT_PUBLIC_PREORDER_URL=

# Phase 0b (Batch 3): Google sign-in through Supabase Auth.
# Both values reach the browser by design; neither is a secret. Values and
# where to find them: docs/SETUP_AUTH.md step 5. No service-role or secret
# key is used anywhere. While either is unset (local dev, e2e builds), every
# account entry point is hidden and the app works for visitors only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Batch 4 PR 1: anonymous counting (docs/ANALYTICS.md). The PostHog project
# key is public by design. While it is unset (local dev, CI, the main e2e
# build), nothing is ever sent. Values are inlined at build time.
NEXT_PUBLIC_POSTHOG_KEY=
# https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=

# Later in Phase 0b and beyond (not used yet)
# RESEND_API_KEY=

# `pnpm test:db` needs no variables: scripts/test-db.sh starts its own
# throwaway Postgres. Optional: PG_BINDIR (Postgres server binaries),
# TEST_PG_PORT (default 54329).

# Phase 4
# PAYMOB_API_KEY=
# PAYMOB_HMAC_SECRET=

# Phase 8
# ANTHROPIC_API_KEY=
# AI_MODEL_FAST=claude-haiku-4-5-20251001
# AI_MODEL_VISION=claude-sonnet-5
